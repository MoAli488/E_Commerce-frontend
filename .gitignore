# ##############################################################################
# Angular Specific Exclusions
# ##############################################################################
# Compiled build outputs
/dist/
/tmp/
/out-tsc/
/bazel-out/

# Angular CLI build cache (Crucial for Angular 14+)
/.angular/

# Code coverage reports generated by tools like Karma or Jest
/coverage/
/e2e/test-output/

# ##############################################################################
# Dependencies & Package Managers
# ##############################################################################
# Local dependencies (always reinstall via npm/yarn/pnpm)
/node_modules/
.pnpm-store/

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ##############################################################################
# Development Environment & Secrets
# ##############################################################################
# Local environment secret variables
.env
.env.local

# IDEs and Text Editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.history/

# Visual Studio Code settings
.vscode/*

# ##############################################################################
# System Files
# ##############################################################################
.DS_Store
Thumbs.db

.prettier*
.prettierrc